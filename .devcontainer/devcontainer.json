{
  "name": "RITSESP Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:dev-24-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    // for later, if we want to containerize the entire stack
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "pwsh ./install.ps1 -CleanInstall", // using -CleanInstall fixes the "string spec" issue...

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/usr/bin/pwsh"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "42Crunch.vscode-openapi"
      ]
    }
  },

  "forwardPorts": [3001, 3000]
}
